<?xml version="1.0" encoding="utf-8"?><!--
   Backup policy (deliberate): the Room database is INCLUDED in cloud backup and
   device transfer — it holds the user's collection, which is expensive to rebuild.
   Room runs in WAL mode, so recent writes may live only in the -wal file until a
   checkpoint; the -wal and -shm files are backed up with the main file.
   Restoring an older DB version is safe because schema migrations are mandatory
   from v4 onward (see AppDatabase.create). Card catalogue and prices are re-imported
   from bundled assets whenever they differ from what the restored DB holds, and
   DataStore holds only sort preferences.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="cardapp.db" />
        <include domain="database" path="cardapp.db-wal" />
        <include domain="database" path="cardapp.db-shm" />
        <include domain="file" path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="cardapp.db" />
        <include domain="database" path="cardapp.db-wal" />
        <include domain="database" path="cardapp.db-shm" />
        <include domain="file" path="datastore" />
    </device-transfer>
</data-extraction-rules>
